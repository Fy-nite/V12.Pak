<Project>

  <!--
    Use absolute paths so V12.Pak resolves V12 and V12.Bindings regardless of build location.
    This avoids Directory.Build.targets path resolution issues when building the submodule standalone.
  -->

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Remove="..\V12-engine\V12.csproj" />
    <ProjectReference Include="D:\git\V12Studio\libs\nova\libs\V12.Basic\libs\V12\V12.csproj" />
    <ProjectReference Include="D:\git\V12Studio\libs\nova\libs\V12.Basic\libs\V12.Bindings\V12.Bindings.csproj" />
  </ItemGroup>

  <!-- Don't compile the nested engine source files — they're pulled from Nova instead -->
  <ItemGroup>
    <Compile Remove="libs/V12-engine/**" />
  </ItemGroup>

</Project>
